{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "consumentenbond.nl": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "button",
              "textFilter": "Niet accepteren"
            }
          }
        ],
        "showingMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "button",
              "textFilter": "Niet accepteren",
              "displayFilter": true
            }
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "DO_CONSENT",
        "action": {
          "type": "click",
          "target": {
            "selector": "button",
            "textFilter": "Niet accepteren"
          }
        }
      },
      {
        "name": "SAVE_CONSENT"
      },
      {
        "name": "UTILITY"
      }
    ]
  }
}
